# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/vedavoice
DATABASE_USER=vedavoice
DATABASE_PASSWORD=vedavoice_pass

# JWT (use a strong random value in production)
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-256-bits
JWT_EXPIRATION=86400000

# OpenAI (required for voice transcription and AI analysis)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server ports
FRONTEND_PORT=4200
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
POSTGRES_PORT=5432

# Node environment
NODE_ENV=development
